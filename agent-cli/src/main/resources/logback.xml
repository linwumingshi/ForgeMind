<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 日志脱敏：%sanitize 替换 %msg -->
    <conversionRule conversionWord="sanitize"
                    converterClass="com.forgemind.cli.logging.SanitizingConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %sanitize%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
